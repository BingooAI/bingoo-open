# Dependencies
node_modules/
.pnp.*
.yarn/*

# Build output
dist/
build/
out/
.turbo/
*.tsbuildinfo
.next/
.next-dev/
next-env.d.ts
*.orig.*

# Generated — regenerate, never edit or commit
generated/
*.lcov

# Test coverage output. Anchored to the places a test runner actually writes it:
# an unanchored `coverage/` also matches a route or module that happens to be
# named "coverage", and silently keeps it out of the repository.
/coverage/
/apps/*/coverage/
/packages/*/coverage/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Test / tooling caches
.vitest/
.eslintcache
.prettiercache

# Local-only assistant notes (see CLAUDE.md)
CLAUDE.md

# Third-party reference material — copyrighted books/papers/curricula, read in place only.
# Never commit: this repository is public and git history is permanent. Curriculum source
# PDFs (Cambridge, MOET) dropped at the repo root for import are covered by the broad rule.
docs/**/*.pdf
*.pdf

# Brand source kit — shipped assets live in apps/*/public/brand; this is the working kit.
/bingoo-brand/

# Internal working notes — migration state, audit findings. Local-only, like CLAUDE.md.
docs/internal/
