# Bingoo API — server-only runtime config. Copy to `.env` for local dev.
# NEVER commit real secrets; `.env` is gitignored.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Comma-separated browser origins allowed to call the API (CORS allowlist).
CORS_ORIGINS=http://localhost:3000

# Postgres connection string (consumed by @bingoo.ai/db). Optional: the API boots
# without it, but /health/db reports "down" until a reachable database is set.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bingoo?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Auth (Better Auth) — server-only (R1). Mounted at /api/auth/*.
# ─────────────────────────────────────────────────────────────────────────────
# Session/token signing secret. REQUIRED in production (the app refuses to boot
# without it); in dev a fallback is used. Generate: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public base URL of THIS API — OAuth callback base + email link origin.
# Defaults to http://localhost:<PORT> when unset.
BETTER_AUTH_URL=http://localhost:4000
# Web app origin that verify / reset links point at.
WEB_URL=http://localhost:3000
# Require email verification before an adult's first login. There is no mail sender:
# verify and reset links are written to the server log. Set "false" to skip the step.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Google OAuth (adults). Both must be set to enable the provider.
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Providers — every external vendor sits behind a swappable capability port.
# Switch a provider by changing its *_PROVIDER key. All server-only (R1).
# Missing keys are fine: /health/providers reports the capability as unconfigured.
# ─────────────────────────────────────────────────────────────────────────────

# Which set of providers to use when a *_PROVIDER key below is not set:
#
#   cloud  (default)  hosted vendors — the fastest way to a working install
#   local             self-hosted or on-machine, no third-party account
#
# A *_PROVIDER key always wins over the profile, so a mixed setup is ordinary
# rather than special — Postgres and Redis on your own machine while calling a
# hosted model is `DEPLOYMENT_PROFILE=local` plus `AI_PROVIDER=claude`.
#
# One capability has no local adapter yet — image. Under `local` it fails at startup
# naming the gap, rather than at the moment a learner needs it. `/health/providers` lists them under `withoutLocalAdapter`.
# Contributions welcome: the ports are defined, only implementations are missing.
#
# `cache` is optional — without it the system simply does not cache. It is not
# reported as degraded, because an installation that skips it is smaller, not broken.
DEPLOYMENT_PROFILE=cloud

# --- Active provider selection (overrides the profile; cloud defaults shown) ---
STORAGE_PROVIDER=r2
TTS_PROVIDER=elevenlabs
AI_PROVIDER=claude
# Translation (dynamic content) can run on a cheaper engine/model than the main AI.
# Blank TRANSLATION_AI_PROVIDER → reuse AI_PROVIDER; TRANSLATION_MODEL blank → adapter default.
# e.g. TRANSLATION_AI_PROVIDER=openai + TRANSLATION_MODEL=gpt-4o-mini, or =claude-haiku-4-5.
TRANSLATION_AI_PROVIDER=
TRANSLATION_MODEL=
IMAGE_PROVIDER=openai
CACHE_PROVIDER=redis

# --- Storage ---
# One implementation serves every S3-compatible store. Pick a provider above:
#
#   STORAGE_PROVIDER=r2   Cloudflare R2 — endpoint derived from the account id
#   STORAGE_PROVIDER=s3   anything else — MinIO, AWS, Backblaze B2, Wasabi, Garage
#
# `local` selects s3. Self-hosted MinIO in Docker, in full:
#
#   docker run -p 9000:9000 -p 9001:9001 quay.io/minio/minio server /data --console-address :9001
#   S3_ENDPOINT=http://localhost:9000
#   S3_BUCKET=bingoo
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=                  # omit for AWS; set for any self-hosted or third-party store
S3_REGION=auto                # AWS needs a real one, e.g. ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket in the path (http://host/bucket/key) rather than the hostname. MinIO and Garage
# require it; AWS and R2 do not. Defaults to on whenever S3_ENDPOINT is set, which is the
# right guess often enough that most setups never touch this.
S3_FORCE_PATH_STYLE=
S3_PUBLIC_BASE_URL=           # optional, public object URLs (bare host or full URL)
S3_SIGNED_URL_TTL=900         # optional, default presigned-URL lifetime (s)

# Cloudflare R2 (STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=            # optional, public object URLs (bare host or full https URL)
R2_SIGNED_URL_TTL=900         # optional, default presigned-URL lifetime (s)

# --- Before the first upload will work: allow your app's origin on the bucket ---
#
# Files go straight from the browser to the bucket — the API only signs a URL. That keeps
# hundreds of megabytes off the server, and it makes the upload a cross-origin request, so
# the bucket has to say it accepts your origin. A fresh bucket accepts none, localhost
# included, and the only thing you are told is:
#
#   No 'Access-Control-Allow-Origin' header is present on the requested resource
#
# which names neither the bucket nor CORS nor the fact that your code is fine. One command,
# against whichever store STORAGE_PROVIDER points at:
#
#   cd apps/api && set -a && . ./.env && set +a
#   pnpm exec tsx src/scripts/storage-cors.ts --origins http://localhost:3000,http://localhost:3001
#   pnpm exec tsx src/scripts/storage-cors.ts --show
#
# Add your production origins the same way. A browser remembers a preflight answer for up to
# an hour, so after changing this, a stale tab can keep failing on its own.

# --- TTS: ElevenLabs (v3) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # default voice
ELEVENLABS_MODEL_ID=eleven_v3

# --- AI (LLM/Agent): Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4096

# --- OpenAI (shared by AI, TTS, Image) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=              # optional (Azure/proxy)
OPENAI_MODEL=gpt-4o          # LLM default
OPENAI_MAX_TOKENS=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# --- Cache: Redis ---
REDIS_URL=redis://localhost:6379

# --- Media library (docs/media-library-design.md) ---
# Semantic search embeddings. Provider behind EmbeddingPort; the OpenAI default
# uses text-embedding-3-small (1536 dims) to match the pgvector column width.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Media search backend. Default `postgres` = tsvector + pgvector on Neon (no extra
# infra); swap to meilisearch/typesense later by adding an adapter, no code change.
SEARCH_PROVIDER=postgres
# Service tokens for the AI/RAG layer to call POST /media/rag/retrieve without a
# user session (sent as the `x-service-token` header). Format: token:label pairs.
# Grant access with MediaGrant rows subjectType=SERVICE, subjectId=<label>. R1.
MEDIA_SERVICE_TOKENS=

# Media enrichment (caption/keyword suggestions). Blank → reuse AI_PROVIDER.
# Point at a provider that has credit without switching the platform AI provider.
# e.g. MEDIA_ENRICH_AI_PROVIDER=openai
MEDIA_ENRICH_AI_PROVIDER=

# ── Model theo TỪNG KHÂU (chi phí) ───────────────────────────────────────────
# ANTHROPIC_MODEL là mặc định chung (Opus — đắt). Các khâu dưới KHÔNG cần Opus:
# authoring = trích xuất có cấu trúc (~14 lượt gọi/tài liệu) → model rẻ là đủ.
AUTHORING_MODEL=claude-haiku-4-5-20251001
# sinh nội dung học cần chất lượng hơn trích xuất, nhưng vẫn không cần Opus.
CONTENT_MODEL=claude-sonnet-5
