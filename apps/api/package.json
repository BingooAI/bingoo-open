    "@bingoo/authored-item": "workspace:^",
    "@bingoo/core": "workspace:^",
    "@bingoo/db": "workspace:^",
    "@bingoo/explainer": "workspace:^",
    "@bingoo/manipulatives": "workspace:^",
    "@bingoo/i18n": "workspace:^",
    "@bingoo/knowledge-engine": "workspace:^",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-validator": "^0.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@upstash/qstash": "^2.11.1",
    "@upstash/workflow": "^1.3.2",
    "better-auth": "^1.6.23",
    "firebase-admin": "^14.1.0",
    "hono": "^4.12.28",
    "html-to-docx": "^1.8.0",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.16.0",
    "markdown-it": "^14.3.0",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "resend": "^6.17.1",
    "zod": "^4.4.3",
