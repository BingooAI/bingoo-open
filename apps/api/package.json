{
  "name": "@bingoo.ai/api-server",
  "version": "0.1.0",
  "private": true,
  "description": "Bingoo backend API (Hono) — server-only: routes → services → repos.",
  "author": "Bingoo.ai (https://bingoo.ai)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
