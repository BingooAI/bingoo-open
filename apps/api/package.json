    "@bingoo.ai/authored-item": "workspace:^",
    "@bingoo.ai/authoring": "workspace:^",
    "@bingoo.ai/authoring-workflow": "workspace:^",
    "@bingoo.ai/codecs": "workspace:^",
    "@bingoo.ai/content-gen": "workspace:^",
    "@bingoo.ai/core": "workspace:^",
    "@bingoo.ai/db": "workspace:^",
    "@bingoo.ai/explainer": "workspace:^",
    "@bingoo.ai/facets": "workspace:^",
    "@bingoo.ai/i18n": "workspace:^",
    "@bingoo.ai/knowledge-engine": "workspace:^",
    "@bingoo.ai/manipulatives": "workspace:^",
    "@bingoo.ai/personalization": "workspace:^",
    "@bingoo.ai/plans": "workspace:^",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/qstash": "^2.12.0",
    "@upstash/workflow": "^1.4.0",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "html-to-docx": "^1.8.0",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.19.1",
    "markdown-it": "^14.3.0",
    "openai": "^6.45.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
