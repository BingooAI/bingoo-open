# Bingoo web — copy to `.env.local` for local development.
# Only NEXT_PUBLIC_* values reach the browser. Never put a secret here.

# The API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The authoring app, linked from the sidebar for staff accounts. A separate
# deployment: another port locally, usually another hostname when self-hosted.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
