# Bingoo web — copy to `.env.local` for local development.
# Only NEXT_PUBLIC_* values reach the browser. Never put a secret here.

# The API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The authoring app, linked from the sidebar for staff accounts. A separate
# deployment: another port locally, usually another hostname when self-hosted.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Sound effects. No audio ships with this repository — the original pack could not be
# traced to a licence that permits redistribution — so effects are silent by default and
# the player falls back to a synthesised blip. Point this at a directory of `<name>.mp3`
# files to enable real audio: `/sfx` to serve them from this app's `public/`, or any URL.
# The names are listed in `packages/explainer/src/sfx-catalog.ts`.
# NEXT_PUBLIC_SFX_BASE_URL=/sfx
