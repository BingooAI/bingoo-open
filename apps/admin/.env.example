# Bingoo admin (authoring) — copy to `.env.local` for local development.
# Only NEXT_PUBLIC_* values reach the browser. Never put a secret here.

# The API this app talks to. NEXT_PUBLIC_* is used in the browser; API_URL is
# used by server components, and may differ inside a container network.
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
