# React Native / Expo need a single, flat copy of react-native (and its peers)
# for Metro to bundle and for NativeWind's className type augmentation to apply
# across workspace packages. pnpm's default isolated linker creates multiple
# peer-hashed copies, which breaks both. `hoisted` is the Expo-recommended layout
# for pnpm monorepos. See docs/design-system.md (native).
node-linker=hoisted
