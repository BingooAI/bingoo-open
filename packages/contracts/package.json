{
  "name": "@bingoo.ai/contracts",
  "version": "0.2.0",
  "private": true,
  "description": "The shared I/O contract for the Bingoo framework family: competency, evidence, content, teaching, assessment and the ports between them.",
  "keywords": [
    "competency-based-education",
    "case",
    "qti",
    "xapi",
    "open-badges",
    "verifiable-credentials",
    "edtech",
    "zod"
  ],
  "license": "Apache-2.0",
  "author": "Bingoo.ai (https://bingoo.ai)",
  "homepage": "https://github.com/BingooAI/bingoo-open",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BingooAI/bingoo-open.git",
    "directory": "packages/contracts"
  },
  "bugs": "https://github.com/BingooAI/bingoo-open/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
