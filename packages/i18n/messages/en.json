  "faq": {
    "metaTitle": "FAQ",
    "metaDescription": "Common questions parents ask about Bingoo — ages, safety, devices, pricing.",
    "title": "Frequently asked questions",
    "subtitle": "What parents often ask about Bingoo.",
    "items": {
      "0": {
        "q": "What is Bingoo?",
        "a": "Bingoo is an online learning platform for kids aged 6–15 that turns lessons into games, with a personalized path and Bingoo as a friendly buddy."
      },
      "1": {
        "q": "What ages is Bingoo for?",
        "a": "Content follows the curriculum for kids aged 6 to 15 and adapts its difficulty to each child's level."
      },
      "2": {
        "q": "Is Bingoo safe for kids?",
        "a": "Yes. Content is moderated, there are no ads, and parents get screen-time controls."
      },
      "3": {
        "q": "What devices can my child learn on?",
        "a": "Bingoo runs in the web browser, on tablets and phones — just sign in and pick up where you left off."
      },
      "4": {
        "q": "Is Bingoo free?",
        "a": "There's a Free plan to get started; Plus and Family unlock the full experience. See the Pricing page for details."
      },
      "5": {
        "q": "How do I cancel?",
        "a": "You can cancel anytime from your account settings — no fees, no strings attached."
      }
    }
  },
