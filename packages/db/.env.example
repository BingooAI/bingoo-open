# Prisma datasource — SERVER-ONLY. Copy to `.env` (gitignored) for local dev.
# Never commit a real connection string.

# Pooled endpoint — used by the API runtime (pg driver adapter).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bingoo?schema=public"

# Direct (unpooled) endpoint — used by the Prisma CLI for migrations. On Neon,
# this is the same URL with `-pooler` removed from the host. Falls back to
# DATABASE_URL when unset.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/bingoo?schema=public"
