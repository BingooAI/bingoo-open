# Prisma datasource — SERVER-ONLY. Copy to `.env` (gitignored) for local dev.
# Never commit a real connection string.

# Pooled endpoint — used by the API runtime (pg driver adapter).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bingoo?schema=public"

# Direct (unpooled) endpoint — used by the Prisma CLI for migrations. On Neon,
# this is the same URL with `-pooler` removed from the host. Falls back to
# DATABASE_URL when unset.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/bingoo?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# TLS, for a hosted database
# ─────────────────────────────────────────────────────────────────────────────
# Against a managed provider (Neon, Supabase, RDS), append an sslmode. Be explicit
# about which one: `sslmode=require` is changing meaning in libpq and node-postgres
# warns about it today. It currently encrypts *without* verifying the certificate,
# which stops a passive eavesdropper but not someone who can answer in the
# server's place.
#
#   ...?sslmode=verify-full          verifies the certificate. Use this.
#   ...?sslmode=require&uselibpqcompat=true   keeps today's weaker behaviour and
#                                             silences the warning. A stopgap.
#
# Example (Neon):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"
#
# A local Postgres on localhost needs none of this.
